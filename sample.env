# from my.telegram.org/apps
API_ID=
API_HASH=

# from @BotFather on telegram
BOT_TOKEN=

# log group id (add the bot as an admin there)
LOGGER_ID=

# mongo url from cloud.mongodb.com
MONGO_URL=

# your telegram user id
OWNER_ID=

# pyrogram string session for the assistant account, from @StringFatherBot on telegram
SESSION=

# optional extra assistant accounts (up to 3)
SESSION2=
SESSION3=

# ---- optional ----
# support links shown in the bot menus
# defaults point at the YoriMusic group/channel; set to empty to hide the buttons
SUPPORT_CHAT=https://t.me/+nzIAZDVK_61lZDQ9
SUPPORT_CHANNEL=https://t.me/yorifederation

# channel the assistant auto-joins on startup (username or invite link)
JOIN_CHANNEL=yorifederation

# web server: serves the landing page and the /health endpoint for uptime
# monitors. Render sets PORT automatically; set WEB_ENABLE=False to disable.
PORT=8080
WEB_ENABLE=True

# artwork used by the bot (local paths or URLs)
DEFAULT_THUMB=assets/thumb.jpg
PING_IMG=assets/ping.jpg
START_IMG=assets/start.jpg

# behaviour toggles
AUTO_LEAVE=False
AUTO_END=False
THUMB_GEN=True
VIDEO_PLAY=True
LANG_CODE=en
DURATION_LIMIT=60
QUEUE_LIMIT=20
PLAYLIST_LIMIT=20
